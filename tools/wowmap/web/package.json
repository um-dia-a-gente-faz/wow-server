{
  "name": "wowmap-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../openapi.json -o src/lib/api.d.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "npm run check && vite build"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.65.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/leaflet": "1.9.21",
    "openapi-typescript": "7.13.0",
    "svelte": "5.56.3",
    "svelte-check": "4.6.0",
    "typescript": "5.9.3",
    "vite": "7.3.5"
  }
}
