# Copy to .env (gitignored) and fill in the placeholders. Never commit .env.
# docker compose reads this file for ${VAR} interpolation in docker-compose.yml,
# docker-compose.agents.yml and (via --env-file) monitoring/docker-compose.yml.

# ─── Server secrets (docker-compose.yml, monitoring/) ──────
# MySQL root password. Only applied when the db_data volume is first created;
# on an existing server set it to the password the DB already uses.
MYSQL_ROOT_PASSWORD=change-me
# Web UI (port 3000) password for ACCESS_USERNAME=admin.
ACCESS_PASSWORD=change-me
# Password of the `trinity` MySQL user created by the image's bootstrap.
# Reference only — no compose file reads it.
# TRINITY_DB_PASSWORD=change-me

# ─── WoW Server ────────────────────────────────────────────
WOW_HOST=192.168.1.64
WOW_AUTH_PORT=3724

# ─── Agent account ─────────────────────────────────────────
# One account per agent.  Accounts AGENT01..AGENT05 exist on the realm.
WOW_ACCOUNT=AGENT01
WOW_PASSWORD=change-me
# Shared password for AGENT01..AGENT05, used by docker-compose.agents.yml.
AGENT_PASSWORD=change-me

# ─── Character (name or guid) ──────────────────────────────
WOW_CHARACTER=Luaprata
# WOW_CHAR_GUID=2

# ─── Agent behaviour ───────────────────────────────────────
AGENT_NAME=Luaprata
AGENT_THINK_INTERVAL_S=5.0
AGENT_RUN_DURATION_S=0
# AGENT_PERSONA=A noble blood-elf paladin, protect the weak

# ─── LLM (future layer 3 — unused for now) ─────────────────
# Primary: FreeLLMAPI proxy on docker-stack, pinned to tool-calling free
# models. Never "auto" alone or first — auto gave ~50% valid tool calls in an
# earlier prototype (docs/LLM_SPIKE.md, UM-61); UM-44 requires >= 90%. As the
# last entry of a fallback list it only answers when the pinned ones are down.
# Get the key from the FreeLLMAPI dashboard; it lives only here, never in docs.
# LLM_BASE_URL=http://192.168.1.60:3002/v1
# LLM_API_KEY=change-me
#
# LLM_MODEL is one model id or a comma-separated ordered fallback list
# (UM-94). On HTTP 429/5xx/404, a timeout or a network error the model goes
# on cooldown (the gateway's Retry-After / "Soonest reset ~Ns" hint, else
# 60s for 429, 30s otherwise, 15 min for 404; clamped to 5s..15min) and the
# next one is tried, at most 3 requests per think cycle. When every model
# is cooling down the cycle is skipped without sending a request. The audit
# log's `model` is the model that actually answered. Probed 2026-09-24
# (one tiny tool call each): these three returned a valid tool call; keep
# `auto` last as a best-effort catch-all.
# LLM_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,poolside-laguna-s-2.1,auto

# Fallback: local OpenAI-compatible server (Ollama/llama.cpp) on the laptop
# (RTX 4060-class, 8 GB) running a 7-8B Q4 model. See docs/LLM_SPIKE.md.
# LLM_BASE_URL=http://192.168.1.61:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
# VERBOSE_PACKETS=false
# Dump raw SMSG_UPDATE_OBJECT payloads (decrypted, inflated) to <dir>/<ts>_<opcode>.bin
# AGENT_DUMP_PACKETS=/tmp/agent-packets