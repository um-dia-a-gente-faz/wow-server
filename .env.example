# Copy to .env (gitignored) and fill in the placeholders. Never commit .env.
# docker compose reads this file for ${VAR} interpolation in docker-compose.yml,
# docker-compose.agents.yml and (via --env-file) monitoring/docker-compose.yml.

# ─── Server secrets (docker-compose.yml, monitoring/) ──────
# MySQL root password. Only applied when the db_data volume is first created;
# on an existing server set it to the password the DB already uses.
MYSQL_ROOT_PASSWORD=change-me
# Web UI (port 3000) password for ACCESS_USERNAME=admin.
ACCESS_PASSWORD=change-me
# Password of the `trinity` MySQL user created by the image's bootstrap.
# Reference only — no compose file reads it.
# TRINITY_DB_PASSWORD=change-me

# ─── WoW Server ────────────────────────────────────────────
WOW_HOST=192.168.1.64
WOW_AUTH_PORT=3724

# ─── Agent account ─────────────────────────────────────────
# One account per agent: AGENT01..AGENT25 (agents/roster.json). AGENT01..05 exist
# on the realm; scripts/create_agent_roster.py creates AGENT06..25.
WOW_ACCOUNT=AGENT01
WOW_PASSWORD=change-me
# Shared password for AGENT01..AGENT25, used by docker-compose.agents.yml and
# by scripts/create_agent_roster.py when it creates the accounts.
AGENT_PASSWORD=change-me

# ─── Character (name or guid) ──────────────────────────────
WOW_CHARACTER=Luaprata
# Standalone runs only (python -m agent). Not passed through docker-compose.agents.yml:
# the guid wins over the name, so one global value would point every service at the same character.
# WOW_CHAR_GUID=2

# ─── Agent behaviour ───────────────────────────────────────
AGENT_NAME=Luaprata
# Passed by docker-compose.agents.yml to agent/config.py. Sets the minimum
# delay between think-loop decisions, in seconds; higher values pace calls less often.
# 3 s since #218 (ADR 0004 D2): Jev p95 is 305 ms, so Jev is not the limit; cost is, see
# AGENT_MAX_TOKENS_PER_HOUR below before copying this into the VM .env.
AGENT_THINK_INTERVAL_S=3.0
AGENT_RUN_DURATION_S=0
# AGENT_PERSONA=A noble blood-elf paladin, protect the weak
# Chat channels joined after login (comma-separated; "none" to disable).
# System channels (General, Trade, LocalDefense, ...) join by ID; anything
# else is a custom channel, e.g. "General,world".
# AGENT_CHANNELS=General
# Read-only observability API (UM-50): GET /healthz /state /perception /brain
# /events. Off unless a port is set; binds to loopback unless AGENT_HTTP_BIND
# says otherwise. docker-compose.agents.yml sets 9601-9625 (agent N: 9600+N) and binds 0.0.0.0.
# AGENT_HTTP_PORT=9601
# AGENT_HTTP_BIND=127.0.0.1
# Host IP the compose file publishes the agent ports on (default all, i.e. LAN).
# AGENT_HTTP_PUBLISH_IP=0.0.0.0
# wowmap's "Agent mind" tab proxies these (monitoring/docker-compose.yml). Empty
# means the tab shows nothing. Do not hand-type it: generate the line from
# agents/roster.json (same names and 9600+N ports as docker-compose.agents.yml),
# giving the host the agent containers run on (no default; the fleet is moving
# off 192.168.1.64 to the wow-agents VM, issue #134):
#   python3 scripts/gen_agent_api_urls.py --host <agent-host>
# Paste the output into the wow-server VM's .env, then recreate wowmap
# (docs/DEPLOYMENT.md, "wowmap's AGENT_API_URLS").
# AGENT_API_URLS=Luaprata=http://<agent-host>:9601,Farstrider=http://<agent-host>:9602
# wowmap's Fleet panel (#137) talks to the agent runner (tools/agent-runner, #136).
# Empty URL = the panel is read-only. The token is the runner's AGENT_RUNNER_TOKEN.
# AGENT_RUNNER_URL=http://<wow-agents LAN IP>:9700
# AGENT_RUNNER_TOKEN=

# ─── Brain selection (#161, docs/adr/0001) ────────────────
# One brain per agent; the LLM and Jev are peers. Default llm, so nothing
# changes until asked for. With AGENT_BRAIN=jev a Jev error is a failed cycle
# (audited with the reason, no LLM call). AGENT_BRAIN_FALLBACK=llm opts in to
# the LLM deciding in Jev's place; the audit then shows substituted=true.
# AGENT_BRAIN=llm
# AGENT_BRAIN_FALLBACK=none

# ─── LLM (the llm brain, or the opt-in fallback) ──────────── ─────────────────
# Primary: FreeLLMAPI router in LXC 301 `freellmapi` on pv1
# (http://192.168.1.72:3001), pinned to tool-calling free models. Never "auto"
# alone or first: auto gave ~50% valid tool calls in an earlier prototype
# (docs/LLM_SPIKE.md, UM-61); UM-44 requires >= 90%. As the last entry of a
# fallback list it only answers when the pinned ones are down.
# The old instance on docker-stack (192.168.1.60:3002) was removed on
# 2026-10-03; its key does not work on the surviving router (401). Take the
# router key from the 192.168.1.72:3001 dashboard (its unified API key); it
# lives only in the VM's .env, never in this file or in docs. At least one
# tool-capable model must be enabled with a provider key in that router, or
# every call fails with 503 no_providers_configured (#133).
# LLM_BASE_URL=http://192.168.1.72:3001/v1
# LLM_API_KEY=change-me
#
# LLM_MODEL is one model id or a comma-separated ordered fallback list
# (UM-94). On HTTP 429/5xx/404, a timeout or a network error the model goes
# on cooldown (the gateway's Retry-After / "Soonest reset ~Ns" hint, else
# 60s for 429, 30s otherwise, 15 min for 404; clamped to 5s..15min) and the
# next one is tried, at most 3 requests per think cycle. When every model
# is cooling down the cycle is skipped without sending a request. The audit
# log's `model` is the model that actually answered. Probed 2026-09-24
# (one tiny tool call each): these three returned a valid tool call; keep
# `auto` last as a best-effort catch-all. Re-probe against the live router
# before relying on this list (docs/AGENT-RUN-1-10.md, "Preflight"): the
# catalog and which models have a key changed since 2026-09-24.
# LLM_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,poolside-laguna-s-2.1,auto

# Fallback: local OpenAI-compatible server (Ollama/llama.cpp) on the laptop
# (RTX 4060-class, 8 GB) running a 7-8B Q4 model. See docs/LLM_SPIKE.md.
# LLM_BASE_URL=http://192.168.1.61:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# ─── Jev decision model (UM-99, docs/adr/0001) ────────────
# Decisions API of the Jev provider, called directly. The owner supplies
# JEV_API_KEY from his own provider access (never commit it, never paste it in
# an issue or PR); set all three here, on the VM (/opt/wow-server/.env, mode 600).
# There is no default endpoint and no OPENROUTER_API_KEY fallback: Jev turns on
# only when JEV_BASE_URL is set, and a key without it leaves Jev off. Pin the
# model for stable behaviour. For local dev point JEV_BASE_URL at tools/jev-mock
# (http://jev-mock:8090/api/alpha with `--profile jev-mock`, see its README;
# no key needed); never on the live realm, the mock answers at random.
# JEV_PROVIDER=openrouter is the explicit opt-in to OpenRouter's base URL
# (https://openrouter.ai/api/alpha) and OPENROUTER_API_KEY; not used by default.
#
# JEV_PATH is the endpoint path appended to JEV_BASE_URL (GH-195); it defaults
# to /decisions. Two providers share the request/response shape and differ in
# base URL, path, model id and key (production target: native TypeSafe, ADR 0001):
#   Native TypeSafe (TypeSafe key):
#     JEV_BASE_URL=https://api.typesafe.ai
#     JEV_PATH=/v1/systemone
#     JEV_MODEL=jev-latest        # TypeSafe rejects "jev-1.13" and the typesafe/ alias
#     JEV_API_KEY=change-me
#   OpenRouter proxy (JEV_PROVIDER=openrouter; OpenRouter key):
#     JEV_PROVIDER=openrouter
#     JEV_PATH=/decisions
#     JEV_MODEL=typesafe/jev-1.13   # or ~typesafe/jev-latest
#     # JEV_API_KEY falls back to OPENROUTER_API_KEY with this provider.
#
# JEV_PROVIDER and OPENROUTER_API_KEY reach the containers (GH-190);
# OPENROUTER_API_KEY is only read when JEV_PROVIDER=openrouter (agent/config.py).
# Jev is used only when AGENT_BRAIN=jev. With the brain's own settings
# missing, agents log in and idle.
# JEV_BASE_URL=https://<provider-host>/<api-path>
# JEV_API_KEY=
# OPENROUTER_API_KEY=
# JEV_MODEL=typesafe/jev-1.13
# Confidence policy (GH-165, agent/brain.py): when Jev's confidence is below
# this, the safe candidate (idle) runs instead of its choice and the audit
# records confidence_rule=low_confidence_safe_fallback. Jev still never
# falls to the LLM. Missing confidence is audited as confidence_unknown and
# acts as chosen. 0.0 (default) = rule off; set it from measured data only.
# JEV_MIN_CONFIDENCE=0.0

# Spend cap (#213, agent/brain.py): input+output tokens ONE agent may spend on
# Jev in any rolling 60 minutes. Once spent, Jev is not called until old calls
# age out: the cycle fails (not idle) and the audit row carries
# jev_status=budget_exhausted with the reason in `fallback`. Spend is reloaded
# from the audit log on start, so restarts do not reset it. Per agent, so the
# fleet ceiling is this x the number of agents. 0 = unlimited. Jev bills input
# only (ADR 0001) but both are counted, so the cap is slightly conservative.
# Ceiling: tokens/h x 730 h x $0.042/M (unverified price) = $15.3/month per
# agent at 500000; 25 agents = ~$380/month. Measured use is 1.6-3.8M tokens/h
# (ADR 0004 F6), so 500000 throttles a 3 s beat to roughly 1 in 6-8 decisions: size it
# to the beat you want, see docs/adr/0004-jev-decision-pacing.md.
# AGENT_MAX_TOKENS_PER_HOUR=500000

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
# VERBOSE_PACKETS=false
# Dump raw SMSG_UPDATE_OBJECT payloads (decrypted, inflated) to <dir>/<ts>_<opcode>.bin
# AGENT_DUMP_PACKETS=/tmp/agent-packets

# tools/agent-runner (agent host only): shared token for its HTTP API, and the
# LAN address it binds. See tools/agent-runner/README.md.
# AGENT_RUNNER_TOKEN=change-me
# AGENT_RUNNER_BIND=192.168.1.80
# wowmap's 3D character models (#171) are not configured here: monitoring/docker-compose.yml
# mounts /opt/wowmap-data/models read-only as MODELS_DIR=/models. Fill it on the VM with
# tools/wowmap/extract_models.py (tools/wowmap/README.md, "Character model"); until then
# the inspect drawer shows "No 3D model extracted".
