# Local secrets (template: .env.example)
.env
.env.*
!.env.example

# WoW client files (user-supplied, ~17 GB, never committed)
client/

# TDB base world dump (downloaded asset, ~280 MB extracted). See tdb/README.md
tdb/*.sql
tdb/*.7z
tdb/*.zip

# Docker volumes / runtime data (bind-mounted dirs)
db_data/
server_data/
server_logs/

# OS junk
.DS_Store
Thumbs.db

# Extracted client DBCs (game data — regenerate with TrinityCore's mapextractor)
tools/wowmap/*.dbc
*.dbc
__pycache__/
artifs/
node_modules/
