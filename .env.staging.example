# Copy to .env.staging (gitignored) and fill in the placeholders. Read only by
# staging/docker-compose.yml, through scripts/staging.sh (#400). Never the game stack's .env.
# Every value here is a dummy: the real ones live on wow-agents, never in git.

# IP the staging worldserver tells clients to use (the wow-agents LAN address).
STAGING_PUBLIC_IP=192.0.2.10

# Web UI password for the staging worldserver (its web UI port is not published).
STAGING_ACCESS_PASSWORD=change-me

# Password for the throwaway accounts STAGING01..STAGING05 (docs/DEPLOYMENT.md, Staging realm). Not read
# by the compose file; the manual seed and the smoke run use it.
STAGING_ACCOUNT_PASSWORD=change-me

# MySQL root password for staging-db. Only applied when staging_db_data is first created.
STAGING_MYSQL_ROOT_PASSWORD=change-me

# Host paths mounted into the staging worldserver. Use copies that live outside the game
# checkout (/opt/wow-server): the client is 17 GB and the TDB must match the pinned binary
# (tdb/README.md, SERVER_VERSION).
STAGING_CLIENT_DIR=/srv/wow-staging/client
STAGING_TDB_FILE=/srv/wow-staging/tdb/TDB_full_world_335.25101_2025_10_21.sql
