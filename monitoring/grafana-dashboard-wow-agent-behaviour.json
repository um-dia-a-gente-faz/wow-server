{
  "uid": "wow-agent-behaviour",
  "title": "WoW — Agent & Player Behaviour",
  "tags": [
    "wow",
    "wow-server",
    "trinitycore",
    "agents",
    "behaviour"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Players online over time",
      "description": "Online autonomous agents and other players, sampled on every Prometheus scrape.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wow_players_online",
          "legendFormat": "players online",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Playtime per character",
      "description": "Accumulated playtime for the exporter’s top played characters.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wow_character_playtime_seconds",
          "legendFormat": "{{character}}",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Current zone distribution",
      "description": "Current online-player distribution by zone. A different bar on refresh indicates movement between zones.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (zone) (wow_online_player_info)",
          "legendFormat": "Zone {{zone}}",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "always",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "barRadius": 0,
        "fullHighlight": false,
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Level progression per character",
      "description": "Level history for the exporter’s top played characters. Lines step up when a character levels.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 1,
          "max": 80,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wow_character_level",
          "legendFormat": "{{character}}",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
