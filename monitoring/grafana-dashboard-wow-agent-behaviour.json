{
  "uid": "wow-agent-behaviour",
  "title": "WoW — Agent & Player Behaviour",
  "tags": [
    "wow",
    "wow-server",
    "trinitycore",
    "agents",
    "behaviour"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Players online over time",
      "description": "Online autonomous agents and other players, sampled on every Prometheus scrape.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wow_players_online",
          "legendFormat": "players online",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Playtime per character",
      "description": "Accumulated playtime for the exporter’s top played characters.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wow_character_playtime_seconds",
          "legendFormat": "{{character}}",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Current zone distribution",
      "description": "Current online-player distribution by zone. A different bar on refresh indicates movement between zones.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (zone) (wow_online_player_info)",
          "legendFormat": "Zone {{zone}}",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "always",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "barRadius": 0,
        "fullHighlight": false,
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Level progression per character",
      "description": "Level history for the exporter’s top played characters. Lines step up when a character levels.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 1,
          "max": 80,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wow_character_level",
          "legendFormat": "{{character}}",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Think cycles & valid tool-call rate (UM-51)",
      "description": "Think cycles per second and the fraction whose LLM tool call resolved to a valid, registered action — from agent.audit's decision log.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "valid rate.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (rate(wow_agent_audit_cycles_total[5m]))",
          "legendFormat": "{{agent}} cycles/s",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(wow_agent_audit_tool_calls_total{valid=\"true\"}[5m])) by (agent) / sum(rate(wow_agent_audit_tool_calls_total[5m])) by (agent)",
          "legendFormat": "{{agent}} valid rate",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Actions by name & outcome (UM-51)",
      "description": "Action call rate over the last 15m, grouped by action name and outcome (ok/invalid/failed), from agent.audit's decision log.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (action, outcome) (rate(wow_agent_action_total[15m])))",
          "legendFormat": "{{action}} ({{outcome}})",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "always",
        "stacking": "normal",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0,
        "fullHighlight": false,
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM latency p95 (UM-51)",
      "description": "95th-percentile LLM call latency per agent, from agent.audit's decision log.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (agent, le) (rate(wow_agent_llm_latency_ms_bucket[5m])))",
          "legendFormat": "{{agent}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Token usage rate (UM-51)",
      "description": "Prompt + completion tokens per second, from agent.audit's decision log (only providers that report `usage`).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (rate(wow_agent_llm_prompt_tokens_total[5m]) + rate(wow_agent_llm_completion_tokens_total[5m]))",
          "legendFormat": "{{agent}} tokens/s",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Deaths & level-ups (last 1h, UM-51)",
      "description": "Deaths and level-ups observed in the decision audit log over the last hour, per agent.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (increase(wow_agent_deaths_total[1h]))",
          "legendFormat": "{{agent}} deaths",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          },
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum by (agent) (increase(wow_agent_levelups_total[1h]))",
          "legendFormat": "{{agent}} level-ups",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "XP per hour (UM-51)",
      "description": "XP gained per hour, derived from the decision audit log's time span per agent.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wow_agent_xp_per_hour",
          "legendFormat": "{{agent}}",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    }
  ]
}
