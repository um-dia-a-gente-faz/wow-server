{
  "uid": "wow-server-host",
  "title": "Wow Server \u2014 Host & Containers",
  "tags": [
    "wow-server",
    "homelab",
    "trinitycore"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Host \u2014 wow-server (192.168.1.64)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU usage",
      "description": "Percent of CPU time not idle (5m rate). During map extraction this pegs ~100%.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\",host=\"wow-server\"}[5m])) * 100)",
          "legendFormat": "CPU %",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Load average",
      "description": "Load average. For 4 vCPU, sustained >4 means saturation.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{host=\"wow-server\"}",
          "legendFormat": "1m",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        },
        {
          "refId": "B",
          "expr": "node_load5{host=\"wow-server\"}",
          "legendFormat": "5m",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        },
        {
          "refId": "C",
          "expr": "node_load15{host=\"wow-server\"}",
          "legendFormat": "15m",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Uptime",
      "description": "Time since last boot.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_time_seconds{host=\"wow-server\"} - node_boot_time_seconds{host=\"wow-server\"}",
          "legendFormat": "uptime",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory",
      "description": "Used / available / cached RAM. VM has 6 GB total.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{host=\"wow-server\"} - node_memory_MemAvailable_bytes{host=\"wow-server\"}",
          "legendFormat": "used",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        },
        {
          "refId": "B",
          "expr": "node_memory_MemAvailable_bytes{host=\"wow-server\"}",
          "legendFormat": "available",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        },
        {
          "refId": "C",
          "expr": "node_memory_Cached_bytes{host=\"wow-server\"}",
          "legendFormat": "cached",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Disk usage \u2014 /",
      "description": "Root filesystem. 50 GB volume: client 17 GB + extracted maps + DB.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_size_bytes{host=\"wow-server\",mountpoint=\"/\"} - node_filesystem_avail_bytes{host=\"wow-server\",mountpoint=\"/\"}",
          "legendFormat": "used",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        },
        {
          "refId": "B",
          "expr": "node_filesystem_avail_bytes{host=\"wow-server\",mountpoint=\"/\"}",
          "legendFormat": "free",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Disk I/O",
      "description": "Disk throughput.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total{host=\"wow-server\",device=~\"sda|vda\"}[5m])",
          "legendFormat": "read",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_written_bytes_total{host=\"wow-server\",device=~\"sda|vda\"}[5m])",
          "legendFormat": "write",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ]
    },
