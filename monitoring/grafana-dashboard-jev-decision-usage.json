      "id": 1,
      "type": "timeseries",
      "title": "Jev calls / sec",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "efnf4d4t8vsw0a"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "calls/s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (rate(wow_agent_jev_calls_total[5m]))",
          "legendFormat": "{{agent}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "efnf4d4t8vsw0a"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
