{
  "uid": "jev-decision-usage",
  "title": "Jev \u2014 decision usage",
  "tags": [
    "wow",
    "wow-server",
    "agents",
    "jev",
    "usage"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
